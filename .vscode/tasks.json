{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev: Full Stack",
      "type": "shell",
      "command": "npm run dev",
      "group": { "kind": "build", "isDefault": true },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "new" }
    },
    {
      "label": "Dev: API Only",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/api" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Dev: Dashboard Only",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/dashboard" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Build: API",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/api" },
      "group": "build",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Build: Dashboard",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/dashboard" },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Docker: Up",
      "type": "shell",
      "command": "docker compose up -d --build",
      "problemMatcher": []
    },
    {
      "label": "Docker: Down",
      "type": "shell",
      "command": "docker compose down",
      "problemMatcher": []
    },
    {
      "label": "Docker: Logs",
      "type": "shell",
      "command": "docker compose logs -f",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "DB: Migrate",
      "type": "shell",
      "command": "npm run db:migrate",
      "problemMatcher": []
    },
    {
      "label": "DB: Seed",
      "type": "shell",
      "command": "npm run db:seed",
      "problemMatcher": []
    },
    {
      "label": "Setup: Install All",
      "type": "shell",
      "command": "npm run setup",
      "problemMatcher": []
    },
    {
      "label": "Docker: PostgreSQL Only",
      "type": "shell",
      "command": "docker compose up -d postgres",
      "problemMatcher": []
    }
  ]
}
