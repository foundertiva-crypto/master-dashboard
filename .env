# ============================================
# TIVA MASTER DASHBOARD — DEVELOPMENT CONFIG
# Platform: Vercel + Oracle Free Tier + Cloudflare
# ============================================

# --- Application ---
NODE_ENV=development
APP_NAME=tiva-master-dashboard
APP_PORT=4000
DASHBOARD_PORT=3000

# --- ERPNext Configuration ---
ERPNEXT_BASE_URL=http://localhost:8000
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# --- PostgreSQL Database (Docker local / Oracle Cloud Free Tier) ---
DB_HOST=localhost
DB_PORT=5433
DB_NAME=master_dashboard
DB_USER=dashboard_user
DB_PASSWORD=changeme
DATABASE_URL=postgresql://dashboard_user:changeme@localhost:5433/master_dashboard

# --- Cloudflare R2 Storage (S3-compatible, free tier: 10GB) ---
# Get from: Cloudflare Dashboard > R2 > Manage R2 API Tokens
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tiva-dashboard-storage
R2_PUBLIC_URL=
# R2 endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# S3 prefixes (shared across storage providers)
STORAGE_UPLOAD_PREFIX=uploads
STORAGE_LOGS_PREFIX=logs
STORAGE_REPORTS_PREFIX=reports
STORAGE_TEMP_PREFIX=temp

# --- AI Configuration (Dual Provider) ---
AI_PROVIDER=openai
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.7

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Claude (Anthropic)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# --- JWT Authentication ---
JWT_SECRET=dev-secret-tiva-master-dashboard-32chars!
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=dev-refresh-secret-tiva-dashboard-32!
JWT_REFRESH_EXPIRES_IN=7d

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- Logging ---
LOG_LEVEL=debug
LOG_TO_FILE=false
LOG_DIR=./logs

# --- CORS ---
CORS_ORIGIN=http://localhost:3000

# --- Internal API Key (service-to-service) ---
INTERNAL_API_KEY=dev-internal-key-change-in-production

# --- Vercel (dashboard deployment) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
