# ============================================
# TIVA MASTER DASHBOARD — ENVIRONMENT CONFIG
# Platform: Vercel + Oracle Free Tier + Cloudflare
# ============================================

# --- Application ---
NODE_ENV=production
APP_NAME=tiva-master-dashboard
APP_PORT=4000
DASHBOARD_PORT=3000

# --- ERPNext Configuration ---
ERPNEXT_BASE_URL=http://localhost:8000
ERPNEXT_API_KEY=your_erpnext_api_key
ERPNEXT_API_SECRET=your_erpnext_api_secret

# --- PostgreSQL Database ---
# Local dev: Docker PostgreSQL
# Production: Oracle Cloud Free Tier (Always Free PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=master_dashboard
DB_USER=dashboard_user
DB_PASSWORD=your_secure_db_password
DATABASE_URL=postgresql://dashboard_user:your_secure_db_password@localhost:5432/master_dashboard

# --- Cloudflare R2 Storage (S3-compatible, free tier: 10GB/month) ---
# Setup: Cloudflare Dashboard > R2 > Create Bucket > Manage API Tokens
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=tiva-dashboard-storage
R2_PUBLIC_URL=
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com

# Storage prefixes
STORAGE_UPLOAD_PREFIX=uploads
STORAGE_LOGS_PREFIX=logs
STORAGE_REPORTS_PREFIX=reports
STORAGE_TEMP_PREFIX=temp

# --- AI Configuration (Dual Provider) ---
AI_PROVIDER=openai
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.7

# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o

# Claude (Anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key
CLAUDE_MODEL=claude-sonnet-4-20250514

# --- JWT Authentication ---
JWT_SECRET=your_jwt_secret_minimum_32_characters_long
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_minimum_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- Logging ---
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_DIR=./logs

# --- CORS ---
CORS_ORIGIN=http://localhost:3000

# --- Internal API Key ---
INTERNAL_API_KEY=your_internal_api_key

# --- Vercel Dashboard URL (set after deploy) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
